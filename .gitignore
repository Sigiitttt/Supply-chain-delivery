# Raw data downloaded from Kaggle (do not commit large raw dataset files)
data/raw/*
!data/raw/.gitkeep
dataset/archive/*.csv

# Generated analytical outputs (exclude raw large CSVs, include optimized Parquet & summaries)
outputs/*.csv
!outputs/eda_kpi_summary.csv
!outputs/brazil_states_coordinates.csv
!outputs/.gitkeep
!outputs/*.parquet

# Python / Jupyter temporary files
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.DS_Store
